# Drive Tech RFQ Worker — environment template.
# Copy to .env and fill in real values. Never commit the filled-in .env.

# ── Oscar backend (the /internal/* API this worker calls) ───────────────────
# Base URL of the Oscar backend, e.g. https://developement-branch.onrender.com
OSCAR_API_URL=
# Must match Oscar's INTERNAL_SERVICE_SECRET exactly (see Oscar repo .env.example)
OSCAR_INTERNAL_SECRET=
# HTTP timeout seconds for calls to Oscar (default 30)
OSCAR_TIMEOUT_SEC=30

# ── OpenAI (classify / extract / match) ──────────────────────────────────────
OPENAI_API_KEY=

# ── Gmail — single shared mailbox, long-lived refresh token ────────────────
# Mint once with scripts/gmail_oauth_bootstrap.py (in the Oscar repo) and paste
# the resulting values here. Google's "testing" consent mode expires this
# refresh token every 7 days — publish the app in Google Cloud Console to fix.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Label applied to processed emails (default: RFQ-Processed)
RFQ_PROCESSED_LABEL=RFQ-Processed

# ── Team lead resolution (fallback when there's no per-user actor context) ──
# Either or both may be set; RFQ_TEAM_LEAD_USER_ID wins if both resolve.
RFQ_TEAM_LEAD_USER_ID=
RFQ_ORG_TEAM_ID=

# ── Poller behaviour ──────────────────────────────────────────────────────
# Seconds between mailbox checks (default 120)
RFQ_POLLER_INTERVAL_SEC=120
# Unread emails scanned per tick (default 10)
RFQ_POLLER_MAX_RESULTS=10
# Task deadline: RFQ_TASK_DUE_MINUTES wins if set, else RFQ_TASK_DUE_HOURS (default 24)
RFQ_TASK_DUE_MINUTES=
RFQ_TASK_DUE_HOURS=24

# ── Price lists ───────────────────────────────────────────────────────────
# Directory of .xlsx price-list files (default: bundled PRICE_LIST_excel/)
PRICE_LIST_DIR=PRICE_LIST_excel

# ── Quotation App (external, separate service) ───────────────────────────────
# Unset or QUOTATION_MOCK=1 -> mock mode (no real quotation created)
QUOTATION_API_URL=
QUOTATION_MOCK=
QUOTATION_API_KEY=
QUOTATION_AUTH_SCHEME=bearer
QUOTATION_FRONTEND_URL=
QUOTATION_TIMEOUT_SEC=30
# Static supplier ("from") block on every generated quotation
QUOTATION_FROM_COMPANY=
QUOTATION_FROM_CONTACT=
QUOTATION_FROM_EMAIL=
QUOTATION_FROM_PHONE=
QUOTATION_FROM_ADDRESS=
QUOTATION_FROM_GSTIN=
QUOTATION_FROM_PAN=

LOG_LEVEL=INFO
