# Drive Tech RFQ Worker — environment template.
# Copy to .env and fill in real values. Never commit the filled-in .env.

# ── Oscar backend (the /internal/* API this worker calls) ───────────────────
# Base URL of the Oscar backend, e.g. https://developement-branch.onrender.com
OSCAR_API_URL=
# Must match Oscar's INTERNAL_SERVICE_SECRET exactly (see Oscar repo .env.example)
OSCAR_INTERNAL_SECRET=
# HTTP timeout seconds for calls to Oscar (default 30)
OSCAR_TIMEOUT_SEC=30

# ── OpenAI (classify / extract / match) ──────────────────────────────────────
OPENAI_API_KEY=

# ── Gmail — single shared mailbox, long-lived refresh token ────────────────
# Mint once with `python gmail_oauth_bootstrap.py` (this directory) and paste
# the resulting values here. Google's "Testing" consent-screen status expires
# this refresh token every 7 days, unconditionally. Fix in Google Cloud
# Console -> OAuth consent screen:
#   - Google Workspace account: set User type = Internal (no expiry, no
#     verification needed, no user cap).
#   - Personal @gmail.com account: click "Publish App" to move it to
#     "In production" (removes the 7-day limit; shows an unverified-app
#     click-through warning at consent time only, harmless for a single
#     internal mailbox). Re-run gmail_oauth_bootstrap.py AFTER publishing —
#     a token minted while still in Testing keeps its 7-day lifetime.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Label applied to processed emails (default: RFQ-Processed)
RFQ_PROCESSED_LABEL=RFQ-Processed

# ── Team lead resolution (fallback when there's no per-user actor context) ──
# Either or both may be set; RFQ_TEAM_LEAD_USER_ID wins if both resolve.
RFQ_TEAM_LEAD_USER_ID=
RFQ_ORG_TEAM_ID=

# ── Poller behaviour ──────────────────────────────────────────────────────
# Seconds between mailbox checks (default 120)
RFQ_POLLER_INTERVAL_SEC=120
# Unread emails scanned per tick (default 10)
RFQ_POLLER_MAX_RESULTS=10
# Task deadline: RFQ_TASK_DUE_MINUTES wins if set, else RFQ_TASK_DUE_HOURS (default 24)
RFQ_TASK_DUE_MINUTES=
RFQ_TASK_DUE_HOURS=24

# ── Price lists ───────────────────────────────────────────────────────────
# Directory of .xlsx price-list files (default: bundled PRICE_LIST_excel/)
PRICE_LIST_DIR=PRICE_LIST_excel

# ── Catalog vector store (Postgres + pgvector) ──────────────────────────────
# The matched-item catalog now lives in Postgres (pgvector extension), not
# in-memory. Apply schema.sql once to a fresh DB, then run
# `python embed_price_lists.py` whenever the .xlsx files in PRICE_LIST_DIR
# change — that script (re)populates catalog_items. The worker only ever
# reads from this DB at runtime; it never re-embeds on its own.
#
# Local dev (Postgres installed locally, e.g. via the EDB installer or
# Postgres.app), after `CREATE DATABASE drivetech_rfq;`:
#   DATABASE_URL=postgres://postgres:<your-local-password>@localhost:5432/drivetech_rfq
#
# Production (e.g. Render Postgres — pgvector is preinstalled there): use the
# "External Database URL" / "Internal Database URL" Render gives you, e.g.:
#   DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# ── Quotation App (external, separate service) ───────────────────────────────
# Unset or QUOTATION_MOCK=1 -> mock mode (no real quotation created)
QUOTATION_API_URL=
QUOTATION_MOCK=
QUOTATION_API_KEY=
QUOTATION_AUTH_SCHEME=bearer
QUOTATION_FRONTEND_URL=
QUOTATION_TIMEOUT_SEC=30
# Static supplier ("from") block on every generated quotation
QUOTATION_FROM_COMPANY=
QUOTATION_FROM_CONTACT=
QUOTATION_FROM_EMAIL=
QUOTATION_FROM_PHONE=
QUOTATION_FROM_ADDRESS=
QUOTATION_FROM_GSTIN=
QUOTATION_FROM_PAN=

LOG_LEVEL=INFO

# ── Quotations MCP Server (server.py, separate Render service at repo root) ─
# Base URL of the quotations backend (default: https://quotations-app.onrender.com)
QUOTATIONS_API_URL=
# HTTP timeout seconds (default 30 — Render free tier can cold-start ~50s)
QUOTATIONS_TIMEOUT=30
# stdio (default) | http — http exposes the MCP endpoint at /mcp
MCP_TRANSPORT=stdio
# Bind for http transport (default 127.0.0.1:8200; Render sets $PORT)
MCP_HOST=127.0.0.1
MCP_PORT=8200
# REQUIRED when MCP_TRANSPORT=http. Shared secret every caller must send as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`. Without this the server
# refuses to start in http mode — it would otherwise expose all quotation data
# (customer names, totals, assignees) to anyone who finds the URL. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=
